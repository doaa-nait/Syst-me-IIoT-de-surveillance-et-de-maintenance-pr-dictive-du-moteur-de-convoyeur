    {
        "id": "3f4dcb8c4c353aac",
        "type": "function",
        "z": "eb5b92fc089d4a2f",
        "name": "Décision",
        "func": "// Règle de décision : moyenne mobile + hystérésis\nconst N = 5;\nconst SEUILS = {\n    temperature: { on: 70, off: 65 },\n    vibration: { on: 6, off: 5 }\n};\nconst capteur = msg.topic;\nconst s = SEUILS[capteur];\nif (!s) return null;\n\n// Moyenne mobile sur les N dernières mesures\nlet hist = flow.get('hist_' + capteur) || [];\nhist.push(msg.payload);\nif (hist.length > N) hist.shift();\nflow.set('hist_' + capteur, hist);\nif (hist.length < N) return null;   // on attend d'avoir N mesures\nconst moy = hist.reduce((a, b) => a + b, 0) / hist.length;\n\n// Hystérésis : deux seuils différents pour allumer et éteindre\nconst avant = flow.get('alarme_' + capteur) || false;\nlet apres = avant;\nif (!avant && moy > s.on) apres = true;\nelse if (avant && moy < s.off) apres = false;\nflow.set('alarme_' + capteur, apres);\n\n// On n'émet un message que lorsque l'état change\nif (apres !== avant) {\n    return {\n        topic: capteur,\n        payload: {\n            capteur: capteur,\n            etat: apres ? 'ALARME' : 'RETOUR_NORMAL',\n            moyenne: Math.round(moy * 10) / 10,\n            seuil: apres ? s.on : s.off,\n            date: new Date().toISOString()\n        }\n    };\n}\nreturn null;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
