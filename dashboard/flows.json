    {
        "id": "493ed397e66cbfbc",
        "type": "function",
        "z": "eb5b92fc089d4a2f",
        "name": "validation",
        "func": "// Validation des mesures reçues (défense en profondeur)\nconst PLAGES = {\n    temperature: { min: -40, max: 80 },   // limites physiques du DHT22\n    vibration: { min: 0, max: 30 }\n};\nconst capteur = msg.topic.split('/').pop();   // \"temperature\" ou \"vibration\"\nconst plage = PLAGES[capteur];\nconst d = msg.payload;\n\nlet erreur = null;\nif (!plage) erreur = \"capteur inconnu\";\nelse if (typeof d !== 'object' || d === null) erreur = \"format invalide (JSON attendu)\";\nelse if (d.qualite && d.qualite !== 'OK') erreur = \"capteur en défaut : \" + d.qualite;\nelse if (typeof d.valeur !== 'number' || isNaN(d.valeur)) erreur = \"valeur non numérique\";\nelse if (d.valeur < plage.min || d.valeur > plage.max) erreur = \"hors plage plausible\";\n\nif (erreur) {\n    node.warn(`Mesure rejetée (${capteur}) : ${erreur}`);\n    return [null, { payload: { capteur, erreur, recu: d, date: new Date().toISOString() } }];\n}\nmsg.topic = capteur;        // sert plus tard à nommer les courbes\nmsg.payload = d.valeur;     // les widgets du dashboard attendent un nombre\nreturn [msg, null];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 140,
        "wires": [
